PORT=3141
NODE_ENV=development

# Required before hosting. Use a long random value and keep it identical across Netlify deploys.
SESSION_SECRET=
MAX_JSON_BODY_BYTES=7000000

# Shopify Admin read-only access. Use only the subdomain part before .myshopify.com.
SHOPIFY_STORE_SUBDOMAIN=
SHOPIFY_ADMIN_API_VERSION=2026-07
SHOPIFY_ADMIN_ACCESS_TOKEN=
SHOPIFY_APP_CLIENT_ID=
SHOPIFY_APP_CLIENT_SECRET=

# Optional paid-order sync. Requires Shopify Admin write_orders scope and an offline token.
# Orders are only created after admin POP/payment confirmation.
SHOPIFY_ORDER_SYNC_ENABLED=false
SHOPIFY_ORDER_INVENTORY_BEHAVIOUR=DECREMENT_OBEYING_POLICY
SHOPIFY_ORDER_SEND_RECEIPT=false

# Protected service-to-service token used by Retail Shark.
INTERNAL_API_TOKEN=

# Future Retail Shark health/status check. Leave blank until Retail Shark exposes a compatible internal health endpoint.
RETAIL_SHARK_INTERNAL_URL=
RETAIL_SHARK_INTERNAL_TOKEN=

# Future hosted database/storage configuration.
DATABASE_URL=
NETLIFY_BLOBS_SITE_ID=
NETLIFY_BLOBS_TOKEN=
PROOF_STORAGE_MODE=local
PROOF_BLOB_STORE=op-payment-proofs

# EFT details shown to customers after order submission.
BANK_ACCOUNT_NAME=Tank Nutrition
BANK_NAME=
BANK_ACCOUNT_NUMBER=
BANK_BRANCH_CODE=
